[TEMPLATE]
# ============================================================
# Modèle de configuration pour docker compose (serveur SGLang)
# Copier ce fichier en `.env` puis adapter au moins SGLANG_MODEL_ROOT :
#   cp .env.example .env
#
# ⚠️ TOUTES les variables sont préfixées SGLANG_ : le shell exporte un jeu de
# variables homonymes (MODEL_ROOT, PORT, TP, ...) qui, sinon, écraserait le
# .env à chaque docker compose (le shell prime sur .env). Le préfixe rend le
# projet immunisé contre ces exports.
# ============================================================

# --- Image Docker ---------------------------------------------------------
# Tag de l'image officielle lmsysorg/sglang (mise à jour SGLang = changer ici).
# "latest" = dernier stable (CUDA 13) ; variantes : latest-runtime (léger,
# sans outils de build), latest-cu129 (CUDA 12.9, driver hôte < 580).
#
# ⚠️ DFLASH2 n'existe dans AUCUNE release : il faut un build de main.
#   - "dev" = build roulant depuis main (contient DFLASH2) — le plus simple :
#       SGLANG_DOCKER_IMAGE=lmsysorg/sglang:dev
#   - ou build local figé au commit 1cf2b8c (reproductible, ~1-2 h) : voir
#     README → « DFLASH2 (optionnel) ». L'image "latest" ne suffit que pour
#     EAGLE (défaut, priorité contexte max).
SGLANG_DOCKER_IMAGE=lmsysorg/sglang:latest

# --- Réseau ---------------------------------------------------------------
# Port HTTP exposé / adresse d'écoute dans le conteneur
SGLANG_PORT=1234
SGLANG_HOST=0.0.0.0

# --- Parallélisme et mémoire ----------------------------------------------
# Taille du tensor parallel ; SGLANG_GPU_COUNT (nombre de GPU exposés) doit
# valoir SGLANG_TP.
SGLANG_TP=2
SGLANG_GPU_COUNT=2
# Contexte ANNoncé par l'API = max réellement utilisable : le pool KV est de
# ~226 K tokens (EAGLE, 0.95) → 220000 affiché, ~6 K de marge pour la sortie.
# 262144 serait annoncé mais rejeté en 400 au-delà du pool. Avec DFLASH2,
# descendre à ~90000.
SGLANG_CONTEXT_LENGTH=220000
# 0.95 = pool KV ~226 K tokens en EAGLE (contexte max, validé : requête
# 200 K tokens OK). Avec DFLASH2 (draft 3,6 Go), baisser à 0.88 (pool ~96 K)
# sinon OOM (0.95 = OOM immédiat, 0.90 = OOM après chargements JIT en service).
SGLANG_MEM_FRACTION=0.95
# 2 requêtes concurrentes (compromis contexte vs charge)
SGLANG_MAX_CONCURRENT_REQUESTS=2

# Attention backend (flashinfer = rapide ; triton = repli si MTP+flashinfer plante au boot)
SGLANG_ATTN_BACKEND=flashinfer

# --- Modèle ---------------------------------------------------------------
# Nom exposé par l'API OpenAI-compatible
SGLANG_SERVED_MODEL_NAME=qwen3.8-27b-int8-w8a16

# IMPORTANT — SGLANG_MODEL_ROOT est OBLIGATOIRE (docker compose refuse de
# démarrer sans). Chemin absolu du dossier PARENT du cache Hugging Face
# local, celui qui contient les dossiers models--* (modèle cible ET draft
# DFLASH2). PAS le snapshot : les fichiers des snapshots sont des liens
# symboliques relatifs vers ../../blobs/... qui doivent rester résolus dans
# le conteneur. Exemple :
#   SGLANG_MODEL_ROOT=/home/<utilisateur>/code/vllm/models
#   (contient models--lued--Qwen3.8-27B-INT8-W8A16-MTP et
#    models--z-lab--Qwen3.8-27B-DFlash2)
SGLANG_MODEL_ROOT=/chemin/vers/le/cache-hf

# Sous-dossier du modèle cible et hash de son snapshot (défauts dans compose.yaml)
# MODEL_REPO_DIR=models--lued--Qwen3.8-27B-INT8-W8A16-MTP
# MODEL_SNAPSHOT=7c12373712d1363e2b76655cb3332c9c124627d7

# --- Décodage spéculatif ---------------------------------------------------
# EAGLE = MTP in-checkpoint (défaut — PRIORITÉ CONTEXTE : pool KV ~226 K).
# DFLASH = draft externe DFlash2 (plus rapide à l'acceptation, +40-100 % en
# débit, mais draft 3,6 Go → pool KV ~96 K max : réservé aux contextes moyens).
# DFLASH exige une image de main (SGLANG_DOCKER_IMAGE=lmsysorg/sglang:dev) et
# SGLANG_MEM_FRACTION=0.88. Le draft est chargé depuis le cache HF local monté.
SPEC_ALGORITHM=EAGLE

# Draft DFlash2 local (utilisé seulement si SPEC_ALGORITHM=DFLASH) :
# sous-dossier et hash de snapshot dans SGLANG_MODEL_ROOT (défauts dans
# compose.yaml).
# DRAFT_REPO_DIR=models--z-lab--Qwen3.8-27B-DFlash2
# DRAFT_SNAPSHOT=50307d4c4cde6860d4eee73e2547cd786fe8e8a4

# Paramètres EAGLE (utilisés seulement si SPEC_ALGORITHM=EAGLE)
SPEC_NUM_STEPS=3
SPEC_EAGLE_TOPK=1

# Tokens draftés : 4 pour EAGLE, 8 pour DFLASH (block size du draft DFlash2).
# Laissé à sa valeur par défaut ici ; le script adapte le défaut selon
# SPEC_ALGORITHM si la variable n'est pas définie.
# SPEC_NUM_DRAFT_TOKENS=4

# --- Cache d'état GDN ------------------------------------------------------
# Slots du cache GDN = SGLANG_MAX_CONCURRENT_REQUESTS x 4 + marge radix.
# La marge (4) réduit le risque de crash "Can not alloc mamba cache" (handoff
# radix d'une requête non finie) sans trop rogner le KV cache. Chaque slot
# coûte ~0,07 Go de VRAM : pool 8 → KV ~226 K tokens ; pool 16 → KV ~188 K
# (plus sûr mais contexte réduit) ; pool 4 → KV ~245 K mais crash possible.
# Préfixe SGLANG_ : évite qu'un export shell de MAMBA_CACHE_SIZE (le shell
# prime sur .env dans docker compose) n'écrase cette valeur.
SGLANG_MAMBA_CACHE_SIZE=8
