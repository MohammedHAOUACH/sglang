# ============================================================
# Modèle de configuration pour docker compose (serveur SGLang)
# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env
# Les défauts ci-dessous sont identiques à ceux de start.sh.
# ============================================================

# Port HTTP exposé / adresse d'écoute
PORT=1234
HOST=0.0.0.0

# Parallélisme et mémoire
TP=2
CONTEXT_LENGTH=262144
# 0.95 = le plus haut sûr sur 2x24 Go (marge pour CUDA graphs/activations)
MEM_FRACTION=0.95
# 1 requête concurrente = max de contexte par requête
MAX_CONCURRENT_REQUESTS=1

# Attention backend (flashinfer = rapide ; triton = repli si MTP+flashinfer plante au boot)
ATTN_BACKEND=flashinfer

# Nom exposé par l'API OpenAI-compatible
SERVED_MODEL_NAME=qwen3.8-27b-int8-w8a16

# Modèle local (cache Hugging Face).
# IMPORTANT : monter le dossier PARENT (models--lued--...) et non le snapshot :
# les fichiers du snapshot sont des liens symboliques relatifs vers
# ../../blobs/... qui doivent rester résolus dans le conteneur.
# MODEL_ROOT=/chemin/vers/cache-hf/models--lued--Qwen3.8-27B-INT8-W8A16-MTP
# MODEL_SNAPSHOT=<hash-du-snapshot>
MODEL_ROOT=/home/yo/Desktop/code/llm/vllm/models/models--lued--Qwen3.8-27B-INT8-W8A16-MTP
MODEL_SNAPSHOT=7c12373712d1363e2b76655cb3332c9c124627d7

# Cache d'état GDN : slots = MAX_CONCURRENT_REQUESTS x 4
MAMBA_CACHE_SIZE=4
